    "# Hypothesis: a signal that needs more wavelet coefficients to be reconstructed\n",
    "# (= higher effective dimension) sits at lower log p. Uses an orthonormal\n",
    "# Daubechies basis (Parseval -> clean energy accounting) and an N-term count:\n",
    "#   k_eff(x) = smallest k s.t. the top-k |c_i|^2 capture a fraction f of ||x||^2.\n",
    "from ortho_wavelet.ReadyToUseWavelets import Db_wavelets\n",
    "from scipy.stats import spearmanr, pearsonr\n",
    "\n",
    "WAVELET_M     = 4                        # Daubechies order (Db4). Longer = smoother filter.\n",
    "\n",
    "# --- 1. Full orthogonal wavelet pyramid on every signal ------------------\n",
    "wavelet = Db_wavelets(m=WAVELET_M, device=x1.device, mode='Periodic')\n",
    "T = x1.shape[-1]\n",
    "J = int(np.floor(np.log2(T)))\n",
    "\n",
    "x_in = x1.reshape(x1.shape[0], x1.shape[-1])    # drop any singleton middle axes\n",
    "a = x_in.to(x_in.device)\n",
    "blocks = []\n",
    "with torch.no_grad():\n",
    "    for _ in range(J):\n",
    "        d, a = wavelet.decompose(a)      # details (hi-freq) at this scale, coarse approx\n",
    "        blocks.append(d.detach().cpu().double().numpy())\n",
    "    blocks.append(a.detach().cpu().double().numpy())   # final coarsest approx\n",
    "coefs = np.concatenate(blocks, axis=-1)                # (n1, ~T)\n",
    "assert coefs.shape[0] == n1, (coefs.shape, n1)\n",
    "\n",
    "# Parseval sanity check: ratio should be ~1.0 for orthonormal Db + periodic padding.\n",
    "e_x = (x1.detach().cpu().double().numpy() ** 2).sum(axis=-1)\n",
    "e_c = (coefs ** 2).sum(axis=-1)\n",
    "print(f\"Parseval ||c||^2 / ||x||^2 : median={np.median(e_c/e_x):.4g}  \"\n",
    "      f\"(1.0 = exact; coefs shape {coefs.shape}, T={T})\")\n",
    "\n",
    "# --- 2. Participation ratio of wavelet coefficients ---------------------\n",
    "# PR^2(x) = ||c||_1^2 / (d * ||c||_2^2) in (0, 1].  Smaller = sparser.\n",
    "# D_eff(x) = d * PR^2(x) = ||c||_1^2 / ||c||_2^2 in [1, d]: effective # active coefs.\n",
    "l1    = np.abs(coefs).sum(axis=-1)\n",
    "l2sq  = (coefs ** 2).sum(axis=-1)\n",
    "d_wav = coefs.shape[-1]\n",
    "pr2   = l1 ** 2 / (d_wav * l2sq)\n",
    "d_eff = l1 ** 2 / l2sq\n",
    "\n",
    "# --- 3. -log p(x) from the already-computed TOTAL contribution -----------\n",
    "neg_log_p = -np.asarray(total_log_p_unnorm, dtype=float)   # (n1,)\n",
    "\n",
    "# --- 4. Correlation summary ---------------------------------------------\n",
    "rp, _ = pearsonr (d_eff, neg_log_p)\n",
    "rs, _ = spearmanr(d_eff, neg_log_p)\n",
    "row = {'D_eff mean': d_eff.mean(), 'D_eff min': d_eff.min(), 'D_eff max': d_eff.max(),\n",
    "       'PR^2 mean': pr2.mean(),\n",
    "       'pearson r': rp, 'spearman rho': rs}\n",
    "for cat, idx in category_indices.items():\n",
    "    row[f'rho ({cat})'] = spearmanr(d_eff[idx], neg_log_p[idx])[0]\n",
    "corr_df = pd.DataFrame([row])\n",
    "display(corr_df)\n",
    "# --- 5. Scatter: k_eff vs -log p ----------------------------------------\n",
    "fig, ax = plt.subplots(figsize=(6.8, 4.6))\n",
    "for cat, idx in category_indices.items():\n",
    "    ax.scatter(d_eff[idx], neg_log_p[idx], s=8, alpha=0.4,\n",
    "               color=category_colors[cat], label=f'{cat} (n={len(idx)})',\n",
    "               edgecolors='none')\n",
    "slope, intercept = np.polyfit(d_eff, neg_log_p, 1)\n",
