   "source": [
    "# === TEST 2026-10-07 (A): one-step test of the late moment misfit. Not part of the rare/typical analysis. ===\n",
    "# Uses potentials_ref, x1, cfg, exp_dir_by_seed, REFERENCE_SEED, device. theta / Theta_reg are NOT used.\n",
    "# All variables made here start with st_ so nothing above is overwritten.\n",
    "import time\n",
    "from time_schedules import build_time_grid\n",
    "\n",
    "N_W = 2000                              # walkers (random subset of x1); no sampling offset by construction\n",
    "ONE_MINUS_T = [1e-1, 1e-2, 1e-3, 1e-4]  # where to test (1 - t0); the misfit appears for 1 - t < 0.05\n",
    "H_FACTORS = [1, 1/4, 1/16]              # step = the run's step at t0 times these\n",
    "N_EXTRA = 3                             # extra corrector passes after the run's single one\n",
    "STEP_SEED = 0\n",
    "# the 11 moments above 1% at the end of BOTH noSm30 arms (index inside the family, gram_along_transport 10-02)\n",
    "MISSED = {'Scalar_psi_gaussianK': [0, 1, 2, 3, 5, 7, 13, 34, 35], 'Scalar_morlet_gaussianK': [0, 6]}\n",
    "\n",
    "st_t_run, _ = build_time_grid(SimpleNamespace(**cfg))          # the run's own grid (two_phase, float64)\n",
    "st_gen = torch.Generator().manual_seed(STEP_SEED)\n",
    "st_idx = torch.randperm(x1.shape[0], generator=st_gen)[:N_W]\n",
    "st_data = x1[st_idx].to(device)\n",
    "st_noise0 = torch.randn(st_data.shape, generator=st_gen).to(device)\n",
    "st_solver = SDE(st_data, N_W, N_W, st_t_run[:2].clone(), cfg['sigma'], dict(potentials_ref), cfg['batch_size'],\n",
    "                device=device, regularization=cfg['regularization'], interpolant=cfg['interpolant'],\n",
    "                x_0=st_noise0, x_k=st_data.clone(), solve_float64=cfg.get('solve_float64', False),\n",
    "                potentials_save_dir=exp_dir_by_seed[REFERENCE_SEED] / 'fitted_potentials')   # loads, never refits\n",
    "\n",
    "st_offs = dict(zip(st_solver.potentials, st_solver.indices_potentials[:-1]))\n",
    "st_missed_cols = np.array([st_offs[F] + i for F, idx in MISSED.items() for i in idx])\n",
    "st_labels = np.array(st_solver.potential_labels)\n",
    "st_is_missed = np.zeros(st_solver.num_potentials, bool); st_is_missed[st_missed_cols] = True\n",
    "st_mbar = lambda x: st_solver.compute_moments(x).double().mean(0)\n",
    "st_data_mom = st_mbar(st_data)\n",
    "\n",
    "st_rows, st_per_stat = [], {}\n",
    "for st_omt in ONE_MINUS_T:\n",
    "    st_k = min(int(torch.searchsorted(st_t_run, torch.tensor(1 - st_omt, dtype=st_t_run.dtype))), len(st_t_run) - 2)\n",
    "    st_t0, st_h_run = float(st_t_run[st_k]), float(st_t_run[st_k + 1] - st_t_run[st_k])\n",
    "    for st_f in H_FACTORS:\n",
    "        st_tic = time.time()\n",
    "        st_h = st_h_run * st_f\n",
    "        st_solver.t = torch.tensor([st_t0, st_t0 + st_h], dtype=torch.float64)\n",
    "        st_solver._rhs_dt_cache = None\n",
    "        st_x_start = st_solver.compute_interpolant(0)                   # exact moments at t0\n",
    "        st_target = st_mbar(st_solver.compute_interpolant(1))\n",
    "        # own scale ~ the run's max_t |target| (its headline metric); for these region shares ~ the data value\n",
    "        st_scale = torch.maximum(st_target.abs(), st_data_mom.abs())\n",
    "        st_ok = (st_scale > cfg.get('moment_threshold', 1e-8)).cpu().numpy()\n",
    "        st_err = lambda x: ((st_mbar(x) - st_target) / st_scale).cpu().numpy()\n",
    "        torch.manual_seed(STEP_SEED)                                    # same standard-normal draw for every h\n",
    "        st_x_next, st_y, *_ = st_solver.iteration_step_projection(st_x_start, 0)\n",
    "        st_errs = [st_err(st_y), st_err(st_x_next)]                     # after predictor, after the run's corrector\n",
    "        st_x = st_x_next\n",
    "        for _ in range(N_EXTRA):\n",
    "            st_th, _ = st_solver.compute_theta(st_x, 0)\n",
    "            st_x = st_x + st_solver.compute_grad_phi_projected(st_x, st_th)\n",
    "            st_errs.append(st_err(st_x))\n",
    "        st_E = np.abs(np.stack(st_errs))                                # (2 + N_EXTRA, r)\n",
    "        st_m, st_o = st_E[:, st_is_missed & st_ok], st_E[:, ~st_is_missed & st_ok]\n",
    "        st_rho = np.median(st_m[2] / np.maximum(st_m[1], 1e-300)) if N_EXTRA else np.nan\n",
    "        st_rows.append({'1-t0': st_omt, 'h/h_run': st_f, 'h': st_h,\n",
    "                        'missed: after predictor': np.median(st_m[0]),\n",
    "                        'missed: after run step': np.median(st_m[1]), 'missed: max after run step': st_m[1].max(),\n",
    "                        f'missed: after +{N_EXTRA} passes': np.median(st_m[-1]),\n",
    "                        'others: after run step (median)': np.median(st_o[1]), 'others: p90': np.percentile(st_o[1], 90),\n",
    "                        'rho (pass2/pass1, missed)': st_rho,\n",
    "                        'steady lag guess r1/(1-rho)': np.median(st_m[1]) / (1 - st_rho) if st_rho < 1 else np.inf,\n",
    "                        'sec': time.time() - st_tic})\n",
    "        st_per_stat[(st_omt, st_f)] = st_E[:, st_missed_cols]\n",
    "\n",
    "st_tab = pd.DataFrame(st_rows).set_index(['1-t0', 'h/h_run'])\n",
    "print(f'{N_W} walkers; own-scale error |mean phi(walkers) - target| / scale, median over the {len(st_missed_cols)} '\n",
    "      f'missed moments vs the {int((~st_is_missed).sum())} others')\n",
    "display(st_tab)\n",
    "\n",
    "# per missed statistic, at the run's own step size: error after predictor / run step / extra passes\n",
    "for st_omt in ONE_MINUS_T:\n",
    "    print(f'1 - t0 = {st_omt:g}, h = h_run')\n",
    "    display(pd.DataFrame(st_per_stat[(st_omt, 1)].T, index=st_labels[st_missed_cols],\n",
    "                         columns=['predictor', 'run step'] + [f'+{i + 1} pass' for i in range(N_EXTRA)]))\n",
    "\n",
    "# error after the run's step vs h, per 1 - t0 (slope 1/2 = noise-limited, 1 = drift/bias-limited)\n",
    "fig, ax = plt.subplots(figsize=(6, 4))\n",
    "for st_omt in ONE_MINUS_T:\n",
    "    st_sel = st_tab.xs(st_omt, level='1-t0')\n",
    "    ax.loglog(st_sel['h'], st_sel['missed: after run step'], 'o-', label=f'missed, 1-t0={st_omt:g}')\n",
    "    ax.loglog(st_sel['h'], st_sel['others: after run step (median)'], 'x:', color=ax.lines[-1].get_color())\n",
    "st_hh = np.array([st_tab['h'].min(), st_tab['h'].max()])\n",
    "ax.loglog(st_hh, st_tab['missed: after run step'].max() * (st_hh / st_hh.max()) ** 0.5, 'k--', lw=0.8, label='slope 1/2')\n",
    "ax.set_xlabel('step h'); ax.set_ylabel('median own-scale error after one step')\n",
    "ax.set_title('TEST 10-07 (A): one step from exact moments (o missed, x others)'); ax.legend(fontsize=7)\n",
    "fig.tight_layout(); plt.show()\n",
    "del st_solver"
   ]
