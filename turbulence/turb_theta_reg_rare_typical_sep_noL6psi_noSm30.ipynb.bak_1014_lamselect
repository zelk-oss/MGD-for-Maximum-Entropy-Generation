    "# === TEST 2026-10-07 (B): sinusoid test of the coarse L_6 signs. Not part of the rare/typical analysis. ===\n",
    "# Uses potentials_ref, reg_all_np (theta per seed, from THETA_SOURCE), seed_keys, family_ranges, x1, compute_phi_X, M.\n",
    "# All variables made here start with sn_ so nothing above is overwritten.\n",
    "AMPS = np.logspace(-1, 2, 25)        # amplitude a, in units of the data std\n",
    "N_PHASE = 4                          # average over a few phases (phi of a pure tone barely depends on it)\n",
    "\n",
    "sn_sd = float(x1.std())\n",
    "sn_filt = potentials_ref['L_6'].filters.reshape(-1, M).abs().cpu()\n",
    "sn_nL6 = sn_filt.shape[0]\n",
    "sn_bin = [int(sn_filt[j, :M // 2 + 1].argmax()) for j in range(sn_nL6)]   # each filter's peak frequency bin\n",
    "sn_n = torch.arange(M, dtype=torch.float64)\n",
    "sn_phases = 2 * np.pi * np.arange(N_PHASE) / N_PHASE\n",
    "\n",
    "def sn_tone(b, a, ph):\n",
    "    \"\"\"rms = a * data std; bin 0 (low-pass) -> constant signal.\"\"\"\n",
    "    if b == 0:\n",
    "        return torch.full((M,), a * sn_sd, dtype=torch.float64)\n",
    "    return a * sn_sd * np.sqrt(2) * torch.sin(2 * np.pi * b * sn_n / M + ph)\n",
    "\n",
    "sn_theta_bar = reg_all_np.mean(0)\n",
    "sn_phi = {}                                               # filter j -> (n_amp, n_features), phi averaged over phases\n",
    "for j, b in enumerate(sn_bin):\n",
    "    sn_X = torch.stack([sn_tone(b, a, ph) for a in AMPS for ph in sn_phases])[:, None].float().to(x1.device)\n",
    "    sn_phi[j] = compute_phi_X(potentials_ref, sn_X).double().numpy().reshape(len(AMPS), N_PHASE, -1).mean(1)\n",
    "\n",
    "# figure: log p(x_a) - log p(x_{a_min}), one panel per L_6 filter; thin = seeds, thick = seed-mean theta\n",
    "sn_cols = 3\n",
    "sn_rows_n = math.ceil(sn_nL6 / sn_cols)\n",
    "fig, axes = plt.subplots(sn_rows_n, sn_cols, figsize=(4.6 * sn_cols, 3.2 * sn_rows_n), squeeze=False)\n",
    "for j in range(sn_nL6):\n",
    "    ax = axes[j // sn_cols][j % sn_cols]\n",
    "    sn_lp = sn_phi[j] @ reg_all_np.T                      # (n_amp, n_seeds)\n",
    "    for s, key in enumerate(seed_keys):\n",
    "        ax.plot(AMPS, sn_lp[:, s] - sn_lp[0, s], lw=0.8, alpha=0.7, label=key)\n",
    "    sn_lpm = sn_phi[j] @ sn_theta_bar\n",
    "    ax.plot(AMPS, sn_lpm - sn_lpm[0], 'k', lw=2, label='seed-mean theta')\n",
    "    ax.axvline(1, color='gray', ls=':', lw=0.8)\n",
    "    ax.axhline(0, color='gray', lw=0.5)\n",
    "    ax.set_xscale('log'); ax.set_yscale('symlog', linthresh=10)\n",
    "    sn_per = 'const' if sn_bin[j] == 0 else f'period {M / sn_bin[j]:.3g}'\n",
    "    ax.set_title(f'L_6[{j}]: bin {sn_bin[j]} ({sn_per})', fontsize=9)\n",
    "    ax.set_xlabel('amplitude a (x data std)', fontsize=8); ax.set_ylabel('log p change (nats)', fontsize=8)\n",
    "axes[0][0].legend(fontsize=6)\n",
    "for j in range(sn_nL6, sn_rows_n * sn_cols):\n",
    "    axes[j // sn_cols][j % sn_cols].axis('off')\n",
    "fig.suptitle(f'TEST 10-07 (B): pure tone at each L_6 filter\\'s peak frequency ({THETA_SOURCE}): '\n",
    "             f'must go DOWN at large a', fontsize=10)\n",
    "fig.tight_layout(); plt.show()\n",
    "\n",
    "# table: at the largest amplitudes, does log p go up, and which family wins?\n",
    "sn_rows = []\n",
    "for j in range(sn_nL6):\n",
    "    sn_lp = sn_phi[j] @ reg_all_np.T\n",
    "    sn_dend = sn_lp[-1] - sn_lp[-4]                       # change over the last 3 amplitude points\n",
    "    sn_grow = np.log(np.abs(sn_lp[-1] - sn_lp[0]) / np.abs(sn_lp[-4] - sn_lp[0])) / np.log(AMPS[-1] / AMPS[-4])\n",
    "    sn_fam = {F: sn_phi[j][-1, a:b] @ sn_theta_bar[a:b] for F, (a, b) in family_ranges.items()}\n",
    "    sn_top = max(sn_fam, key=lambda F: abs(sn_fam[F]))\n",
    "    sn_rows.append({'L_6 filter': j, 'period': np.inf if sn_bin[j] == 0 else M / sn_bin[j],\n",
    "                    'seeds where log p RISES at large a': int((sn_dend > 0).sum()),\n",
    "                    'seed-mean theta rises': bool((sn_phi[j][-1] - sn_phi[j][-4]) @ sn_theta_bar > 0),\n",
    "                    'growth power (seed median)': np.median(sn_grow),\n",
    "                    'largest family at a_max (seed mean)': sn_top, 'its value': sn_fam[sn_top],\n",
    "                    'L_6 value': sn_fam['L_6']})\n",
    "display(pd.DataFrame(sn_rows).set_index('L_6 filter'))\n",
    "print(f'THETA_SOURCE = {THETA_SOURCE!r}, {len(seed_keys)} seeds; a_max = {AMPS[-1]:g} x data std. \"growth power\" ~ the '\n",
    "      f'exponent of the term that wins at large a (6 for L_6, 4 for Scat4, alpha for a Scalar outermost region).')"
