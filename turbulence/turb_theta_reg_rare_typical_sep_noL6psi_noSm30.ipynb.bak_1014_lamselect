    "    ax.plot(ch, sub_t['KS floor (data half vs half)'], 'k_', ms=10, label='floor (data half vs half)')\n",
    "    ax.set_xlabel('channel (0 = finest)'); ax.set_ylabel('KS'); ax.set_title(f'{pname}: red = has a missed statistic', fontsize=9)\n",
    "    ax.legend(fontsize=7)\n",
    "fig.suptitle('TEST 10-08 (C): wavelet-coefficient marginals, model vs data', fontsize=10)\n",
    "fig.tight_layout(); plt.show()\n",
