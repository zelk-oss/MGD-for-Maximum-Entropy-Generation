    "    ax.set_xlabel('|wavelet coefficient|', fontsize=8)\n",
    "axes[0][0].legend(fontsize=6)\n",
    "for p_i in range(len(mg_plot), mg_nrow * mg_cols):\n",
    "    axes[p_i // mg_cols][p_i % mg_cols].axis('off')\n",
    "fig.suptitle('TEST 10-08 (C): |coefficient| histograms (log-log), dashed = region cuts; core = left of the first cut',\n",
    "             fontsize=10)\n",
    "fig.tight_layout(); plt.show()"
   ]
