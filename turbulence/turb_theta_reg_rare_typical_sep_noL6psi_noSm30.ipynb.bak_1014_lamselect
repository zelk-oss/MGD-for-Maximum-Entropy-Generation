    "LAM_CHECK = 1e-3          # the lam where Pearson dipped while Spearman stayed ~1; then try the chosen lam\n",
    "TOP = 20                   # signals listed\n",
    "\n",
    "lp = logp_by_lam[LAM_CHECK]                       # (n_seeds, n1)\n",
    "sd = lp.std(0, ddof=1)                            # seed-to-seed spread of each signal's log p\n",
    "mu = lp.mean(0)\n",
    "is_rare = np.zeros(lp.shape[1], bool); is_rare[np.asarray(idx_rare)] = True\n",
    "e_pct = stats.rankdata(e_split) / len(e_split) * 100          # extremeness percentile of each signal\n",
    "\n",
    "order = np.argsort(sd)[::-1]\n",
    "top = pd.DataFrame({'signal': order[:TOP], 'log p seed spread': sd[order[:TOP]], 'log p mean': mu[order[:TOP]],\n",
