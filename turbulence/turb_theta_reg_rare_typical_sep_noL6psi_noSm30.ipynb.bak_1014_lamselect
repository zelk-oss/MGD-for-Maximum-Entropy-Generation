    "# === TEST 2026-10-08 (C): do the 11 missed moments show up in the fine-scale wavelet marginals? ===\n",
    "# Not part of the rare/typical analysis. Needs section 6's first cell (sample_path, needs_norm) to have run.\n",
    "# Uses potentials_ref, x1, seed_keys, sample_path, needs_norm, normalize, M, device. theta is NOT used.\n",
    "# All variables made here start with mg_ so nothing above is overwritten.\n",
    "from scipy import stats as mg_stats\n",
    "\n",
    "MG_MISSED = {'Scalar_psi_gaussianK': [0, 1, 2, 3, 5, 7, 13, 34, 35], 'Scalar_morlet_gaussianK': [0, 6]}\n",
    "MG_CONTROL = {'Scalar_psi_gaussianK': [10, 15, 20], 'Scalar_morlet_gaussianK': [4]}  # channels with no missed stat\n",
    "MG_KS_N = 200_000          # coefficients drawn per channel for the KS test (data and each seed)\n",
    "MG_SEED = 0\n",
    "mg_rng = np.random.default_rng(MG_SEED)\n",
    "\n",
    "def mg_coeffs(P, x, chunk=1000):\n",
    "    \"\"\"Wavelet coefficients the potential sees: (n * M, J) array, real part, as in Scalar_GGD_KRegion.\"\"\"\n",
    "    out = []\n",
    "    f = P.filters.to(device)\n",
    "    for i in range(0, x.shape[0], chunk):\n",
    "        xb = x[i:i + chunk].to(device)\n",
    "        out.append(torch.fft.ifft(f * torch.fft.fft(xb)).real.permute(0, 2, 1).reshape(-1, f.shape[1]).cpu())\n",
    "    return torch.cat(out).double().numpy()\n",
    "\n",
    "def mg_stat_mean(P, x, chunk=1000):\n",
    "    return torch.cat([P.forward(x[i:i + chunk].to(device)).cpu() for i in range(0, x.shape[0], chunk)]).double().mean(0).numpy()\n",
    "\n",
    "# model samples per seed, as section 6 loads them\n",
    "mg_model = {}\n",
    "for key, path in sample_path.items():\n",
    "    xs = torch.load(path, map_location='cpu').reshape(-1, 1, M)\n",
    "    mg_model[key] = normalize(xs) if needs_norm else xs\n",
    "mg_keys = list(mg_model)\n",
    "print(f'model samples: {len(mg_keys)} seeds, {mg_model[mg_keys[0]].shape[0]} signals each | data x1: {x1.shape[0]} signals')\n",
    "\n",
    "mg_rows, mg_stat_rows, mg_plot = [], [], []\n",
    "for name, missed in MG_MISSED.items():\n",
    "    P = potentials_ref[name]\n",
    "    J, K = P.J, P.K\n",
    "    flat = P.active_flat.cpu().tolist()\n",
    "    cuts = P.cuts.cpu().double().numpy()                                 # (J, K - 1)\n",
    "    missed_jk = {divmod(flat[i], J)[::-1] for i in missed}               # {(channel, region)}\n",
    "    missed_ch = sorted({j for j, _ in missed_jk})\n",
    "\n",
    "    z_data = mg_coeffs(P, x1)\n",
    "    z_mod = {k: mg_coeffs(P, mg_model[k]) for k in mg_keys}\n",
    "    # KS floor: two disjoint halves of the data, same draw size (what pure sampling noise gives)\n",
    "    n_sig = x1.shape[0]\n",
    "    half = mg_rng.permutation(n_sig)\n",
    "    rows_a = (half[:n_sig // 2, None] * M + np.arange(M)).ravel()\n",
    "    rows_b = (half[n_sig // 2:, None] * M + np.arange(M)).ravel()\n",
    "    draw = lambda a: a[mg_rng.choice(len(a), min(MG_KS_N, len(a)), replace=False)]\n",
    "\n",
    "    for j in range(J):\n",
    "        a_d = np.abs(z_data[:, j])\n",
    "        edges = np.concatenate([[0.0], cuts[j], [np.inf]])\n",
    "        share_d = np.histogram(a_d, edges)[0] / len(a_d)\n",
    "        share_m = np.stack([np.histogram(np.abs(z_mod[k][:, j]), edges)[0] / len(z_mod[k]) for k in mg_keys])\n",
    "        ks = [mg_stats.ks_2samp(draw(z_data[:, j]), draw(z_mod[k][:, j])).statistic for k in mg_keys]\n",
    "        ks_floor = mg_stats.ks_2samp(draw(z_data[rows_a, j]), draw(z_data[rows_b, j])).statistic\n",
    "        mg_rows.append({'potential': name.replace('_gaussianK', ''), 'channel': j,\n",
    "                        'has missed stat': j in missed_ch,\n",
    "                        'KS model vs data (seed mean)': np.mean(ks), 'KS floor (data half vs half)': ks_floor,\n",
    "                        'core share data (region 0)': share_d[0],\n",
    "                        'core share model (seed mean)': share_m[:, 0].mean(),\n",
    "                        'core share model (seed std)': share_m[:, 0].std(ddof=1) if len(mg_keys) > 1 else np.nan,\n",
    "                        'region 1 share data': share_d[1] if K > 1 else np.nan,\n",
    "                        'region 1 share model': share_m[:, 1].mean() if K > 1 else np.nan})\n",
    "        if j in missed_ch or j in MG_CONTROL[name]:\n",
    "            mg_plot.append((name, j, j in missed_ch, a_d, {k: np.abs(z_mod[k][:, j]) for k in mg_keys}, cuts[j]))\n",
    "\n",
    "    # the potential's own statistics on the final samples: (model - data) / data, for the missed ones\n",
    "    s_d = mg_stat_mean(P, x1)\n",
    "    s_m = np.stack([mg_stat_mean(P, mg_model[k]) for k in mg_keys])\n",
    "    for i in missed:\n",
    "        k_reg, j = divmod(flat[i], J)\n",
    "        mg_stat_rows.append({'statistic': f'{name}[{i}]', 'channel': j, 'region': k_reg,\n",
