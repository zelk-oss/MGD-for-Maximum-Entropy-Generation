    "# KS per channel, missed channels highlighted, with the sampling-noise floor\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 3.4), gridspec_kw={'width_ratios': [22, 30]})\n",
    "for ax, (pname, sub_t) in zip(axes, mg_tab.groupby(level='potential', sort=False)):\n",
    "    ch = sub_t.index.get_level_values('channel')\n",
